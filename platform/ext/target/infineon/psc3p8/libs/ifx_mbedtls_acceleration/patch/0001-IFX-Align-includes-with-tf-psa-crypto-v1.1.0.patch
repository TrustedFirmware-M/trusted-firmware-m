+++ b/mbedtls_MXCRYPTOLITE/ecdsa_alt_mxcryptolite.c
@@ -29,7 +29,11 @@

 #if defined (CY_IP_MXCRYPTOLITE)

-#include "mbedtls/build_info.h"
+#if defined(IFX_TF_PSA_CRYPTO_INCLUDES)
+#include "tf-psa-crypto/build_info.h"
+#else
+#include "mbedtls/build_info.h"
+#endif

