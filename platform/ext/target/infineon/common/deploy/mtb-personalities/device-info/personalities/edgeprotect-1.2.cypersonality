    <ParamBool templateId='domain_crypto' id='pc4write' name='Allow writes' group='`${displayPath}`/Memory/PC 4' default='`${isPsc3p8 || isPsc3m6 ? getExposedMember(M33S_domain_location, "pc4write") : true}`' visible='`${show_detailed_configuration}`' editable='false' desc='$PROTECTION_DOMAIN_WRITE_TOOLTIP' />
