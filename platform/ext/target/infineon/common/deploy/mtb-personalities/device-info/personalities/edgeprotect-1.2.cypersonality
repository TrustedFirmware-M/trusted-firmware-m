    <ParamBool templateId='domain_crypto' id='pc3' name='PC 3' group='`${displayPath}`/Peripheral Protection/Accessible by:' default='`${isPsc3p8 || isPsc3m6 ? getExposedMember(M33S_domain_location, "pc3") : false}`' visible='`${show_detailed_configuration}`' editable='false' desc='$PROTECTION_DOMAIN_PC_TOOLTIP' />
