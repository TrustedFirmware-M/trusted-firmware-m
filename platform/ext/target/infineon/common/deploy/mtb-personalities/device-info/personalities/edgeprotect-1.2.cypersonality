    <ParamBool templateId='domain_crypto' id='pc6read' name='Allow reads' group='`${displayPath}`/Memory/PC 6' default='`${isPsc3p8 || isPsc3m6 ? getExposedMember(M33S_domain_location, "pc6read") : false}`' visible='`${show_detailed_configuration}`' editable='false' desc='$PROTECTION_DOMAIN_READ_TOOLTIP' />
