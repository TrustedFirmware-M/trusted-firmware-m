      <Arg value='`${"--config=" . cfgFilePath}`' />
    </ParamCustom>

    <!-- TF-M Platform preset -->
    <ParamString id='tfm_platform' default='`${getOrDefault(getCustomData("/TfmDataEntry[@key=\"platform\"]/@value"), "")}`' />
    <ParamString id='security' default='`${toLower(getDeviceAttr("SECURITY"))}`' />
    <ParamBool id='isPse84Epc2' default='`${(tfm_platform eq "PSE84" || tfm_platform eq "") &amp;&amp; security eq "epc2"}`' />
    <ParamBool id='isPse84Epc4' default='`${(tfm_platform eq "PSE84" || tfm_platform eq "") &amp;&amp; security eq "epc4"}`' />
    <ParamBool id='isPsc3p8' default='`${(tfm_platform eq "PSC3P8" || tfm_platform eq "") &amp;&amp; security eq "epc3"}`' />
    <ParamBool id='isPsc3m6' default='`${tfm_platform eq "PSC3M6"}`' />

    <!-- Standard partitions -->
    <ParamBool id='tfm_services_crypto_ENABLED' default='false' editable='true' />
    <ParamBool id='tfm_services_attestation_ENABLED' default='false' editable='true' />
    <ParamBool id='tfm_services_its_ENABLED' default='false' editable='true' />
