    <ParamBool templateId='domain_crypto' id='pc0read' name='Allow reads' group='`${displayPath}`/Memory/PC 0' default='`${isPsc3p8 || isPsc3m6 ? getExposedMember(M33S_domain_location, "pc0read") : true}`' visible='`${show_detailed_configuration}`' editable='false' desc='$PROTECTION_DOMAIN_READ_TOOLTIP' />
