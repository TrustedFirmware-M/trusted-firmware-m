    <ParamBool templateId='domain_crypto' id='pc4ns' default='`${!pc4access}`' />

    <ParamBool templateId='domain_crypto' id='pc5' name='PC 5' group='`${displayPath}`/Peripheral Protection/Accessible by:' default='`${isPsc3p8 || isPsc3m6 ? getExposedMember(M33S_domain_location, "pc5") : false}`' visible='`${show_detailed_configuration}`' editable='false' desc='$PROTECTION_DOMAIN_PC_TOOLTIP' />
