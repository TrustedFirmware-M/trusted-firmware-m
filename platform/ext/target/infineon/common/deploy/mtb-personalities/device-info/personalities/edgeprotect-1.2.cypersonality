    <ParamBool templateId='domain_crypto' id='pc6ns' default='`${!pc6access}`' />

    <ParamBool templateId='domain_crypto' id='pc7' name='PC 7' group='`${displayPath}`/Peripheral Protection/Accessible by:' default='`${isPsc3p8 || isPsc3m6 ? getExposedMember(M33S_domain_location, "pc7") : true}`' visible='`${show_detailed_configuration}`' editable='false' desc='$PROTECTION_DOMAIN_PC_TOOLTIP' />
    <ParamBool templateId='domain_crypto' id='pc7read' name='Allow reads' group='`${displayPath}`/Memory/PC 7' default='`${isPsc3p8 || isPsc3m6 ? getExposedMember(M33S_domain_location, "pc7read") : true}`' visible='`${show_detailed_configuration}`' editable='false' desc='$PROTECTION_DOMAIN_READ_TOOLTIP' />
    <ParamBool templateId='domain_crypto' id='pc7write' name='Allow writes' group='`${displayPath}`/Memory/PC 7' default='`${isPsc3p8 || isPsc3m6 ? getExposedMember(M33S_domain_location, "pc7write") : true}`' visible='`${show_detailed_configuration}`' editable='false' desc='$PROTECTION_DOMAIN_WRITE_TOOLTIP' />
