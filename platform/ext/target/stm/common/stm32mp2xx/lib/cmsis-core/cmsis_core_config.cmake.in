# This CMake script template contains the set of cmsis-core options settled on
# secure side build but necessary for building the non-secure side too.

set(CMSIS_CORE_PATH          @CMSIS_CORE_PATH@              CACHE PATH      "Path to cmsis-core package (or DOWNLOAD to fetch automatically)")
set(CMSIS_CORE_GIT_REMOTE    @CMSIS_CORE_GIT_REMOTE@        CACHE STRING    "URL (or path) to retrieve cmsis-core package")
set(CMSIS_CORE_VERSION       @CMSIS_CORE_VERSION@           CACHE STRING    "version of cmsis-core package")
