/dts-v1/;

#include <dt-bindings/clock/stm32mp21-clksrc.h>
#include <dt-bindings/power/stm32mp25-power.h>
#include <dt-bindings/regulator/stm32mp21-regulator.h>
#include <dt-bindings/regulator/st,stpmic2.h>
#include <dt-bindings/reset/st,stm32mp21-rcc.h>
#include <dt-bindings/rif/stm32mp25-rif.h>
#include <dt-bindings/rif/stm32mp2-rifsc.h>
#include <dt-bindings/rif/stm32mp21-rifsc.h>
#include <dt-bindings/rif/stm32mp2-risaf.h>
#include <dt-bindings/rif/stm32mp25-risab.h>
#include <dt-bindings/tamp/st,stm32mp21-tamp.h>
#include <dt-bindings/gpio/st,stm32mp21-tamp-gpio.h>
#include <dt-bindings/memory-attr/memory-attr-arm.h>

#include "stm32mp215.dtsi"
#include "stm32mp21xf.dtsi"
#include "stm32mp215f-dk-cm33tdcid-resmem.dtsi"
#include "stm32mp215f-dk-cm33tdcid-rcc.dtsi"
#include "stm32mp215f-dk-cm33tdcid-s-rif.dtsi"
#include "stm32mp21-pinctrl.dtsi"
#include "stm32mp21xxan-pinctrl.dtsi"

/ {
	model = "STMicroelectronics STM32MP215F-DK A35_SDCARD Discovery Board";
	compatible = "st,stm32mp215f-dk-cm33tdcid-sdcard", "st,stm32mp215f-dk", "st,stm32mp215";
	aliases {
		serial0 = &uart4;
	};

	chosen {
		stdout-device = &uart4;
		tfm,entropy = &rng1;
		tfm,watchdog = &iwdg3;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x80000000>;
	};
};

&iac {
	status = "okay";
};

&serc {
	status = "okay";
};

&uart4 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&uart4_pins_a>;
	pinctrl-1 = <&uart4_sleep_pins_a>;
	clocks = <&rcc CK_KER_UART4>;
	current-speed = <115200>;
	status = "okay";
};

&systick {
	clocks = <&rcc CK_ICN_HS_MCU>;
	clock-frequency = <1000000>; /* tick at 1us */
	status = "okay";
};

&tim2 {
	status = "okay";
};

&i2c3 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&i2c3_pins_a>;
	pinctrl-1 = <&i2c3_sleep_pins_a>;
	i2c-scl-rising-time-ns = <31>;
	i2c-scl-falling-time-ns = <2>;
	clock-frequency = <400000>;
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;

	stpmic2l: pmic@33 {
		compatible = "st,stpmic2l";
		reg = <0x33>;
		interrupts-extended = <&exti1 52 IRQ_TYPE_EDGE_FALLING>;
		interrupt-controller;
		#interrupt-cells = <1>;
		status = "okay";

		regulators {
			compatible = "st,stpmic2-regulators";

			vddcore: buck1 {
				regulator-name = "vddcore";
				regulator-min-microvolt = <820000>;
				regulator-max-microvolt = <820000>;
				regulator-always-on;
				st,pwrctrl-sel = <1>;
				st,pwrctrl-enable;

				default {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <820000>;
				};
				lplv {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <670000>;
				};
				standby {
					regulator-off-in-suspend;
				};
				off {
					regulator-off-in-suspend;
				};
			};
			vdd2_ddr: buck2 {
				regulator-name = "vdd2_ddr";
				regulator-min-microvolt = <1100000>;
				regulator-max-microvolt = <1100000>;
				regulator-always-on;
				st,pwrctrl-sel = <1>;
				st,pwrctrl-enable;

				default {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1100000>;
				};
				lplv {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1100000>;
				};
				standby {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1100000>;
				};
				off {
					regulator-off-in-suspend;
				};
			};
			vddcpu: buck3 {
				regulator-name = "vddcpu";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <910000>;
				regulator-always-on;
				st,pwrctrl-sel = <2>;
				st,pwrctrl-enable;

				default {
					regulator-off-in-suspend;
				};
				lplv {
					regulator-off-in-suspend;
				};
				standby {
					regulator-off-in-suspend;
				};
				off {
					regulator-off-in-suspend;
				};
			};
			vdda1v8_aon: ldo1 {
				regulator-name = "vdda1v8_aon";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				st,mask-reset;
			};
			vddio_pmic: ldo2 {
				regulator-name = "vddio_pmic";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				st,mask-reset;
			};
			vdd1_ddr: ldo3 {
				regulator-name = "vdd1_ddr";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				st,pwrctrl-sel = <1>;
				st,pwrctrl-enable;

				default {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
				lplv {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
				standby {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
				off {
					regulator-off-in-suspend;
				};
			};
			vdd3v3_usb: ldo4 {
				regulator-name = "vdd3v3_usb";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-over-current-protection;

				standby {
					regulator-off-in-suspend;
				};
				off {
					regulator-off-in-suspend;
				};
			};
			vdd_flash: ldo5 {
				regulator-name = "vdd_flash";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-over-current-protection;
				st,pwrctrl-sel = <3>;
				st,pwrctrl-reset;
			};
			vdda_1v8: ldo6 {
				regulator-name = "vdda_1v8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				st,pwrctrl-sel = <1>;
				st,pwrctrl-enable;

				default {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
				lplv {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
				standby {
					regulator-off-in-suspend;
				};
				off {
					regulator-off-in-suspend;
				};
			};
			v3v3: gpo1 {
				regulator-name = "v3v3";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;

				standby {
					regulator-off-in-suspend;
				};
				off {
					regulator-off-in-suspend;
				};
			};
			v_gpo3: gpo3 {
				regulator-name = "gpo3";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				st,pwrctrl-sel = <1>;
				st,pwrctrl-enable;

				default {
					regulator-on-in-suspend;
				};
				lplv {
					regulator-on-in-suspend;
				};
				standby {
					regulator-on-in-suspend;
				};
				off {
					regulator-off-in-suspend;
				};
			};
		};
	};
};

&bsec {
	memory-region = <&bsec_mirror>;
	status = "okay";

	board_id: board_id@3d8 {
		#nvmem-cell-cells = <0>;
		reg = <0x3d8 0x4>;
	};
};

&pwr {
	status = "okay";

	pwr_intc: interrupt-controller {
		status = "okay";
	};

	pwr_rif: access-controller {
		status = "okay";
	};

	regulators {
		status = "okay";

		vdda18adc: vdda18adc {
			status = "okay";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			vin-supply = <&vdda_1v8>;
		};

		vddio1: vddio1 {
			status = "okay";
			vin-supply = <&vddio_pmic>;
		};

		vddio2: vddio2 {
			status = "okay";
			vin-supply = <&vdda_1v8>;
		};

		vddio3: vddio3 {
			status = "okay";
			vin-supply = <&vddio_pmic>;
		};

		vddio: vddio {
			status = "okay";
			vin-supply = <&vddio_pmic>;
		};
	};
};

&ramcfg {
	status = "okay";
};

&rtc {
	status = "okay";
};

&hpdma1 {
	status = "okay";
};

&hpdma2 {
	status = "okay";
};

&hpdma3 {
	status = "okay";
};

&exti1 {
	status = "okay";
};

&exti2 {
	status = "okay";
};

&tamp {
	status = "okay";
	st,tamp-passive-precharge = <2>;
	st,tamp-passive-nb-sample = <4>;
	st,tamp-passive-sample-clk-div = <16384>;
	st,tamp-active-filter = <1>;
	st,tamp-active-clk-div = <2048>;

	tamp-button {
		compatible = "st,stm32-tamp-external";
		tamper-gpios = <&tamp STM32_TAMP_GPIO_IN(5, PF6) 0>;
		st,tamp-mode = <TAMPER_CONFIRMED_MODE>;
		st,tamp-id = <5>;
		status = "okay";
	};
};

&hconf1_otp {
	shadow-provisionning = <0x00018db6>;
};

&nvram {
	status = "okay";
};

&risab3 {
	status = "okay";
};

&risab5 {
	status = "okay";
};

&risaf1 {
	status = "okay";
};

&risaf4 {
	status = "okay";
};

&rifsc {
	status = "okay";
};

&rng1 {
	status = "okay";
};

&iwdg3 {
	/* If the watchdog is started the NS application must ping watchdog */
	/*status = "okay";*/
	timeout-sec = <120>;
};

&saes {
	status = "okay";
};

&sau {
	memory-region = <&peripheral_ns>, <&cm33_cube_fw>, <&cm33_cube_data>, <&ltdc_m33_layer>, <&fwu_shmem>;
	status = "okay";
};

&mpu {
	status = "okay";
};

&syscfg {
	st,reg-init = <STM32MP21_SYSCFG_ICNE2EBWRCR 0x00000051>,
		      <STM32MP21_SYSCFG_ICNCPU1BWLCR 0x00005002>;
};
