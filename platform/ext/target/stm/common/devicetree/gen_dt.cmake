# default config
set(CROSS_COMPILE arm-none-eabi CACHE STRING  "Cross-compilation triplet")

# requirement
find_package(Python3)
find_program(CMAKE_C_COMPILER ${CROSS_COMPILE}-gcc)

# internal variables
set(DT_DIR ${CMAKE_CURRENT_LIST_DIR})
set(DT_GEN_EDT_SCRIPT ${DT_DIR}/gen_edt.py)
set(DT_GEN_DEFINES_SCRIPT ${DT_DIR}/gen_defines.py)
set(DT_EDTLIB_LOGGER_SCRIPT ${DT_DIR}/edtlib_logger.py)

# output variables
set(GENERATED_DT_DIR ${CMAKE_BINARY_DIR}/generated/devicetree)

# dt_set_output_paths: defines every output generation path
#
# The following variables are set in the calling scope:
#   <target>_DT_GEN_H       devicetree header generated by gen_defines.py
#   <target>_DT_EDT_PICKLE  pickled edtlib.EDT object, gen_edt.py to gen_defines.py
#   <target>_DT_OUT_DTS     merged devicetree source, kept as a debugging aid
#   <target>_DTS_POST_CPP   devicetree source after the C preprocessor
#   <target>_DTS_DEPS       preprocessor dependency file, fed to DEPFILE
macro(dt_set_output_paths target dts_board out_dir)
    file(MAKE_DIRECTORY ${out_dir})

    get_filename_component(${target}_DTS_FILENAME "${dts_board}" NAME)

    set(${target}_DT_GEN_H      ${out_dir}/devicetree_generated.h)
    set(${target}_DT_EDT_PICKLE ${out_dir}/edt.pickle)
    set(${target}_DT_OUT_DTS    ${out_dir}/out.dts)
    set(${target}_DTS_POST_CPP  ${out_dir}/${${target}_DTS_FILENAME}.pre.tmp)
    set(${target}_DTS_DEPS      ${out_dir}/${${target}_DTS_FILENAME}.pre.d)
endmacro()

function(dt_preprocess)
    set(req_single_args "OUT_FILE")
    set(single_args "DEPS_FILE;DEPS_TARGET;WORKING_DIRECTORY")
    set(req_multi_args "SOURCE_FILES")
    set(multi_args "EXTRA_CPPFLAGS;INCLUDE_DIRECTORIES")
    cmake_parse_arguments(DT_PREPROCESS "" "${req_single_args};${single_args}" "${req_multi_args};${multi_args}" ${ARGN})

    foreach(arg ${req_single_args} ${req_multi_args})
        if(NOT DEFINED DT_PREPROCESS_${arg})
            message(FATAL_ERROR "dt_preprocess() missing required argument: ${arg}")
        endif()
    endforeach()

    set(include_opts)
    foreach(dir ${DT_PREPROCESS_INCLUDE_DIRECTORIES})
        list(APPEND include_opts -isystem ${dir})
    endforeach()

    set(source_opts)
    foreach(file ${DT_PREPROCESS_SOURCE_FILES})
        list(APPEND source_opts -include ${file})
    endforeach()

    set(deps_opts)
    if(DEFINED DT_PREPROCESS_DEPS_FILE)
        list(APPEND deps_opts -MD -MF ${DT_PREPROCESS_DEPS_FILE})
        if(DEFINED DT_PREPROCESS_DEPS_TARGET)
            list(APPEND deps_opts -MT ${DT_PREPROCESS_DEPS_TARGET})
        endif()
    endif()

    set(workdir_opts)
    if(DEFINED DT_PREPROCESS_WORKING_DIRECTORY)
        list(APPEND workdir_opts WORKING_DIRECTORY ${DT_PREPROCESS_WORKING_DIRECTORY})
    endif()

    if(CMAKE_C_COMPILER STREQUAL "CMAKE_C_COMPILER-NOTFOUND")
        message(FATAL_ERROR "Could not find compiler: '${CMAKE_C_COMPILER}'")
    endif()

    set(preprocess_cmd ${CMAKE_C_COMPILER}
        -x assembler-with-cpp
        -nostdinc
        ${include_opts}
        ${source_opts}
        ${NOSYSDEF_CFLAG}
        -D__DTS__
        ${DT_PREPROCESS_EXTRA_CPPFLAGS}
        -E   # Stop after preprocessing
        ${deps_opts}
        -o ${DT_PREPROCESS_OUT_FILE}
        ${DT_DIR}/misc/empty_file.c
        ${workdir_opts}
    )

    unset(ret)

    #for debug add COMMAND_ECHO STDOUT ECHO_OUTPUT_VARIABLE
    execute_process(COMMAND ${preprocess_cmd} ECHO_ERROR_VARIABLE RESULT_VARIABLE ret)
    if(NOT "${ret}" STREQUAL "0")
        message(FATAL_ERROR "failed to preprocess devicetree files (error code: ${ret})")
    endif()

endfunction()

macro(gen_devicetree_h)
    set(options "")
    set(oneValueArgs TARGET DT_BINDINGS_DIR DT_OUT_DIR DTS_BOARD)
    set(multiValueArgs DTS_DIR DTC_FLAGS EXTRA_CPPFLAGS)
    cmake_parse_arguments(A "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})

    dt_set_output_paths(${A_TARGET} ${A_DTS_BOARD} ${A_DT_OUT_DIR})

    dt_preprocess(
        SOURCE_FILES ${A_DTS_BOARD}
        OUT_FILE ${${A_TARGET}_DTS_POST_CPP}
        DEPS_FILE ${${A_TARGET}_DTS_DEPS}
        DEPS_TARGET ${${A_TARGET}_DT_GEN_H}
        EXTRA_CPPFLAGS ${A_EXTRA_CPPFLAGS}
        INCLUDE_DIRECTORIES ${A_DTS_DIR}
        WORKING_DIRECTORY ${A_DT_OUT_DIR}
    )

    set(ENV{PYTHONPATH} ${DT_PYTHON_DEVICETREE_SRC})

    # gen_edt.py takes '--dtc-flags' as a single string that it scans for
    # known flags, so the list is joined into one whitespace separated value.
    # The '--dtc-flags=<flag_1> <flag_2>' form is required: passed as a separate
    # argument, argparse would mistake a value starting with '-' for an
    # option of its own and bail out.
    string(JOIN " " ${A_TARGET}_DTC_FLAGS_STR ${A_DTC_FLAGS})

    set(${A_TARGET}_CMD_GEN_EDT ${Python3_EXECUTABLE} ${DT_GEN_EDT_SCRIPT}
        --dts ${${A_TARGET}_DTS_POST_CPP}
        --dtc-flags=${${A_TARGET}_DTC_FLAGS_STR}
        --bindings-dirs ${A_DT_BINDINGS_DIR}
        --workspace-dir ${A_DT_OUT_DIR}
        --dts-out ${${A_TARGET}_DT_OUT_DTS}
        --edt-pickle-out ${${A_TARGET}_DT_EDT_PICKLE}
        --vendor-prefixes ${A_DT_BINDINGS_DIR}/vendor-prefixes.txt
    )

    set(${A_TARGET}_CMD_GEN_DEFINES ${Python3_EXECUTABLE} ${DT_GEN_DEFINES_SCRIPT}
        --header-out  ${${A_TARGET}_DT_GEN_H}
        --edt-pickle ${${A_TARGET}_DT_EDT_PICKLE}
    )

    #for debug add COMMAND_ECHO STDOUT ECHO_OUTPUT_VARIABLE
    execute_process(COMMAND ${${A_TARGET}_CMD_GEN_EDT} ECHO_ERROR_VARIABLE RESULT_VARIABLE ret)
    if(NOT "${ret}" STREQUAL "0")
        message(FATAL_ERROR "failed to generate edt files (error code: ${ret})")
    endif()

    execute_process(COMMAND ${${A_TARGET}_CMD_GEN_DEFINES} ECHO_ERROR_VARIABLE RESULT_VARIABLE ret)
    if(NOT "${ret}" STREQUAL "0")
        message(FATAL_ERROR "failed to generate define files (error code: ${ret})")
    endif()

    if (EXISTS ${${A_TARGET}_DT_GEN_H})
        message(STATUS "DEVICETREE: ${A_TARGET}: generation done")
    else()
        message(FATAL_ERROR "DEVICETREE: ${A_TARGET}: fail")
    endif()

endmacro()

macro(add_devicetree_target)
    set(options "")
    set(oneValueArgs TARGET DTS_BOARD)
    set(multiValueArgs DTS_DIR DTC_FLAGS EXTRA_CPPFLAGS)
    cmake_parse_arguments(ARG "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})

    # add dts/dtsi and include directory defined by devicetree config
    # This is a macro, so the variables live in the caller scope and would
    # otherwise accumulate across calls: reset them before appending.
    set(${ARG_TARGET}_DTS_DIR "")
    list(APPEND ${ARG_TARGET}_DTS_DIR ${DT_DTS_DIR} ${DTS_SOC_DIR} ${DTS_BOARDS_DIR} ${DTS_EXT_DIR} ${DT_INCLUDE_DIR})

    foreach(dir ${ARG_DTS_DIR})
        file(REAL_PATH ${dir} ${ARG_TARGET}_EXTRA_DIR EXPAND_TILDE)
        if (EXISTS ${${ARG_TARGET}_EXTRA_DIR})
            list(APPEND ${ARG_TARGET}_DTS_DIR ${${ARG_TARGET}_EXTRA_DIR})
        endif()
    endforeach()

    # check board file
    find_file(${ARG_TARGET}_DTS_BOARD NAME ${ARG_DTS_BOARD} PATHS ${${ARG_TARGET}_DTS_DIR})
    if(${ARG_TARGET}_DTS_BOARD STREQUAL ${ARG_TARGET}_DTS_BOARD-NOTFOUND)
        message(FATAL_ERROR "devicetree: board ${ARG_DTS_BOARD} not found in:\n ${${ARG_TARGET}_DTS_DIR}")
    endif()

    # prepare TARGET flags
    set(${ARG_TARGET}_DTC_FLAGS ${ARG_DTC_FLAGS})
    set(${ARG_TARGET}_EXTRA_CPPFLAGS ${ARG_EXTRA_CPPFLAGS})

    #prepare out
    set(${ARG_TARGET}_DT_OUT_DIR ${GENERATED_DT_DIR}/${ARG_TARGET})
    dt_set_output_paths(${ARG_TARGET} ${${ARG_TARGET}_DTS_BOARD} ${${ARG_TARGET}_DT_OUT_DIR})

    # A CMake list is a ';' separated string. Inside add_custom_command(COMMAND)
    # each ';' would split the value into extra command line arguments, which
    # 'cmake -P' would then reject. '$<SEMICOLON>' is the documented way to
    # carry a literal ';' through that splitting: the generator expression is
    # expanded after the argument list is built, so the value stays a single
    # argument and reaches the script as a genuine CMake list.
    # No whitespace round trip is involved, so values containing spaces or
    # quotes (e.g. -DFOO="a b") are preserved verbatim.
    string(REPLACE ";" "$<SEMICOLON>" ${ARG_TARGET}_DTS_DIR_ARG        "${${ARG_TARGET}_DTS_DIR}")
    string(REPLACE ";" "$<SEMICOLON>" ${ARG_TARGET}_DTC_FLAGS_ARG      "${${ARG_TARGET}_DTC_FLAGS}")
    string(REPLACE ";" "$<SEMICOLON>" ${ARG_TARGET}_EXTRA_CPPFLAGS_ARG "${${ARG_TARGET}_EXTRA_CPPFLAGS}")

    set(GEN_DT_OPT
        -DTARGET=${ARG_TARGET}
        -DDTS_BOARD=${${ARG_TARGET}_DTS_BOARD}
        -DDTS_DIR=${${ARG_TARGET}_DTS_DIR_ARG}
        -DDT_BINDINGS_DIR=${DT_BINDINGS_DIR}
        -DDTC_FLAGS=${${ARG_TARGET}_DTC_FLAGS_ARG}
        -DEXTRA_CPPFLAGS=${${ARG_TARGET}_EXTRA_CPPFLAGS_ARG}
        -DDT_OUT_DIR=${${ARG_TARGET}_DT_OUT_DIR}
    )

    # The devicetree is generated at build time only. DEPFILE makes the build
    # system read back the includes discovered by the preprocessor, so the
    # header is regenerated whenever any .dts/.dtsi/.h it depends on changes,
    # and stays untouched otherwise.
    #
    # Add the YAML bindings and the devicetree python package itself), so those
    # are globbed here and added explicitly to DEPENDS.
    # CONFIGURE_DEPENDS re-runs the glob (and reconfigures) whenever a
    # binding/python file is added or removed.
    file(GLOB_RECURSE ${ARG_TARGET}_DT_BINDINGS_FILES CONFIGURE_DEPENDS
        ${DT_BINDINGS_DIR}/*.yaml
    )
    file(GLOB ${ARG_TARGET}_DT_PYTHON_DEVICETREE_FILES CONFIGURE_DEPENDS
        ${DT_PYTHON_DEVICETREE_SRC}/devicetree/*.py
    )

    add_custom_command(
        OUTPUT ${${ARG_TARGET}_DT_GEN_H}
        BYPRODUCTS
            ${${ARG_TARGET}_DT_EDT_PICKLE}
            ${${ARG_TARGET}_DT_OUT_DTS}
        DEPENDS
            ${DT_DIR}/gen_dt.cmake
            ${DT_GEN_EDT_SCRIPT}
            ${DT_GEN_DEFINES_SCRIPT}
            ${DT_EDTLIB_LOGGER_SCRIPT}
            ${DT_BINDINGS_DIR}/vendor-prefixes.txt
            ${${ARG_TARGET}_DT_BINDINGS_FILES}
            ${${ARG_TARGET}_DT_PYTHON_DEVICETREE_FILES}
        DEPFILE ${${ARG_TARGET}_DTS_DEPS}
        COMMENT "DEVICETREE: ${ARG_TARGET}: preprocess and header generation"
        COMMAND ${CMAKE_COMMAND} ${GEN_DT_OPT} -P ${DT_DIR}/gen_dt.cmake
        VERBATIM
    )

    add_custom_target(dt_${ARG_TARGET}_gen_h DEPENDS
        ${${ARG_TARGET}_DT_GEN_H}
    )

    add_library(dt_${ARG_TARGET}_header INTERFACE)
    target_include_directories(dt_${ARG_TARGET}_header
        INTERFACE
            ${DT_INCLUDE_DIR}
            ${${ARG_TARGET}_DT_OUT_DIR}
    )

    # Add static library dt_${ARG_TARGET}_libs
    # Place here all drivers self-register via the devicetree
    # DEVICE_DT_INST_DEFINE or SYS_INIT macro, which places an entry in a custom
    # linker section instead of being referenced by symbol from other code.
    # ld only pulls .o files out of a static archive to resolve an undefined
    # symbol, so it would silently drop these object files and their linker
    # section entries when native_drivers_TARGET is linked normally.
    # This is why TARGET links dt_TARGET_libs with
    # "-Wl,--whole-archive" / "-Wl,--no-whole-archive" below:
    # it forces the linker to keep every object file from this library.
    add_library(dt_${ARG_TARGET}_libs STATIC)

    target_sources(dt_${ARG_TARGET}_libs
        PRIVATE
            ${DT_DIR}/initlevel.c
    )

    target_compile_options(dt_${ARG_TARGET}_libs
        PRIVATE
            $<TARGET_PROPERTY:${ARG_TARGET},COMPILE_OPTIONS>
            ${COMPILER_CMSE_FLAG}
    )

    target_compile_definitions(dt_${ARG_TARGET}_libs
        PRIVATE
            $<TARGET_PROPERTY:${ARG_TARGET},COMPILE_DEFINITIONS>
    )

    target_include_directories(dt_${ARG_TARGET}_libs
        PRIVATE
            $<TARGET_PROPERTY:${ARG_TARGET},INCLUDE_DIRECTORIES>
    )

    target_link_libraries(dt_${ARG_TARGET}_libs
        PUBLIC
            dt_${ARG_TARGET}_header
    )

    target_link_libraries(${ARG_TARGET}
        PUBLIC
            dt_${ARG_TARGET}_header
        PRIVATE
            "-Wl,--whole-archive"
            dt_${ARG_TARGET}_libs
            "-Wl,--no-whole-archive"
    )

    add_dependencies(${ARG_TARGET} dt_${ARG_TARGET}_gen_h)
    add_dependencies(dt_${ARG_TARGET}_libs dt_${ARG_TARGET}_gen_h)
endmacro()

if(DEFINED TARGET)
    gen_devicetree_h(
        TARGET ${TARGET}
        DTS_BOARD ${DTS_BOARD}
        DTS_DIR ${DTS_DIR}
        DT_BINDINGS_DIR ${DT_BINDINGS_DIR}
        DTC_FLAGS ${DTC_FLAGS}
        EXTRA_CPPFLAGS ${EXTRA_CPPFLAGS}
        DT_OUT_DIR ${DT_OUT_DIR}
    )
endif()
